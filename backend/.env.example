# Required for AI chat. Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Exact browser origins allowed to call this API, comma-separated.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5181,http://127.0.0.1:5181

# Optional contact delivery via Resend. Leave unset to return a clear unavailable response.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
