# Local development uses the Vite /api proxy; no browser API URL is needed.
API_PROXY_TARGET=http://127.0.0.1:8000

# Set this in Vercel to your public Render origin, then rebuild.
# VITE_API_BASE_URL=https://your-service.onrender.com

# EmailJS browser configuration (public identifiers, never private API keys).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
